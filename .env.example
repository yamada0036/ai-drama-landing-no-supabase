# Tally form ID from a public form URL.
# Example: https://tally.so/r/abc123 or https://tally.so/embed/abc123 -> abc123
NEXT_PUBLIC_TALLY_FORM_ID=

# Optional: use a full Tally URL instead of FORM_ID.
# Leave empty if you use NEXT_PUBLIC_TALLY_FORM_ID.
NEXT_PUBLIC_TALLY_DIRECT_URL=

# Optional: public links shown on the page.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your_account/
NEXT_PUBLIC_PATREON_URL=
NEXT_PUBLIC_SUBSTACK_URL=
